---
import { Icon } from "astro-icon/components";

const techIcons = [
  { name: "HTML5", icon: "logos:html-5" },
  { name: "CSS3", icon: "logos:css-3" },
  { name: "JavaScript", icon: "logos:javascript" },
  { name: "React", icon: "logos:react" },
  { name: "Svelte", icon: "logos:svelte-icon" },
  { name: "Tailwind CSS", icon: "logos:tailwindcss-icon" },
];
---

<section class="py-section relative">
  <div
    id="particles-js"
    class="absolute inset-0 top-0 left-0 w-full h-full pointer-events-none"
  >
  </div>
  <div class="relative z-10 container-main">
    <div class="text-center hero-copy">
      <!-- <div class="flex items-center justify-center gap-3 mb-8">
        {
          techIcons.map((iconItem) => (
            <div
              class="w-8 h-8 text-ink-tertiary transition-colors hover:text-ink-primary"
              title={iconItem.name}
            >
              <Icon name={iconItem.icon} class="w-full h-full" />
            </div>
          ))
        }
      </div> -->
      <h1 class="mb-6 text-titulo">
        Consigue clientes por Internet con una landing que convierta
      </h1>
      <div class="mb-8">
        <h2 class="text-subtitulo mb-8 text-ink-primary">Yonaiker Barreto</h2>
        <p class="text-ink-secondary text-base-size">
          Creo landing pages rápidas y profesionales para pequeños negocios que
          quieren conseguir clientes por Internet
        </p>
      </div>
      <a href="#about" class="btn-primary"> Conoce mas </a>
    </div>
  </div>
</section>

<script>
  import { tsParticles } from "@tsparticles/engine";
  import { loadSlim } from "@tsparticles/slim";

  (async () => {
    await loadSlim(tsParticles);

    await tsParticles.load({
      id: "particles-js",
      options: {
        fullScreen: { enable: false }, // ← Importante: no pantalla completa, solo el div
        background: {
          color: {
            value: "#ffffff", // Fondo oscuro del hero
          },
        },
        particles: {
          number: {
            value: 200,
            density: {
              enable: true,
            },
          },
          color: {
            value: "#000000", // Azul claro para las partículas
          },
          shape: {
            type: "circle",
          },
          size: {
            value: { min: 1, max: 3 },
            random: true,
          },
          links: {
            enable: true,
            distance: 150,
            color: "#000000",
            opacity: 0.2,
            width: 1,
          },
          move: {
            enable: true,
            speed: 1.2,
            direction: "none",
            random: false,
            straight: false,
            outModes: {
              default: "bounce",
            },
          },
        },
        interactivity: {
          events: {
            onHover: {
              enable: true,
              mode: "grab", // Al pasar el mouse, "agarrar" partículas cercanas
            },
            onClick: {
              enable: true,
              mode: "push", // Al hacer click, añadir partículas
            },
          },
          modes: {
            grab: {
              distance: 200,
              links: {
                opacity: 0.5,
              },
            },
            push: {
              quantity: 4,
            },
          },
        },
        detectRetina: true,
      },
    });
  })();
</script>

<script>
  import { gsap } from "gsap";
  import { SplitText } from "gsap/SplitText";
  gsap.registerPlugin(SplitText);

  document.fonts.ready.then(() => {
    const split = SplitText.create("h1", {
      type: "words, chars",
      wordsClass: "palabra++",
    });

    const tl = gsap.timeline();

    tl.from(split.chars, {
      y: 20,
      autoAlpha: 0,
      stagger: {
        amount: 0.7,
      },
    })
      .from(".hero-copy h2", {
        y: 20,
        autoAlpha: 0,
        duration: 0.5,
      })
      .from(".hero-copy p", {
        y: 20,
        autoAlpha: 0,
        duration: 0.5,
      })
      .from(".hero-copy a", {
        y: 20,
        autoAlpha: 0,
        duration: 0.5,
      });
  });
</script>
