---
---

<section class="bg-fill-hover">
  <div class="container-main py-section">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <div>
        <h2 class="text-heading-lg mb-8">Contactate conmigo</h2>
        <form
          id="contact-form"
          class="space-y-6"
          action="https://formsubmit.co/yonaikereliezerbarretomaterano@gmail.com"
          method="POST"
        >
          <div>
            <label for="name" class="label">Nombre</label>
            <input
              type="text"
              id="name"
              name="nombre"
              class="input-field"
              required
            />
          </div>
          <div>
            <label for="email" class="label">Correo electronico</label>
            <input
              type="email"
              id="email"
              name="correo"
              class="input-field"
              required
            />
          </div>
          <div>
            <label for="message" class="label">Mensaje</label>
            <textarea
              id="message"
              name="mensaje"
              rows="5"
              class="input-field resize-none"
              required
            ></textarea>
          </div>
          <button type="submit" class="btn-primary">
            Enviar
          </button>
          <input type="hidden" name="_next" value="https://eliezer516.github.io/gracias/" />
          <input type="hidden" name="_subject" value="Solicitud de contratacion" />
          <input type="hidden" name="_captcha" value="false" />
        </form>
      </div>
      <div class="flex flex-col justify-center">
        <div class="space-y-4">
          <p class="text-ink-secondary">
            Estoy disponible para proyectos de maquetacion web, desarrollo frontend y redaccion digital.
          </p>
          <p class="text-ink-secondary">
            No dudes en contactarme para cualquier consulta o propuesta de colaboracion.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
